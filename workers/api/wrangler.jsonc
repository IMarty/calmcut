{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calmcut-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Les identifiants de base sont des placeholders jusqu'à ce qu'Igor crée
  // l'infrastructure — voir docs/cloudflare-manual.md. Ce fichier ne contient
  // aucun secret : ils passent tous par `wrangler secret put`.
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_ORIGIN": "http://localhost:8787",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calmcut-db-preview",
      "database_id": "PLACEHOLDER_A_REMPLACER",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],

  "r2_buckets": [{ "binding": "DATA", "bucket_name": "calmcut-data" }],

  // 60 requêtes par minute et par appareil (§8.2). La limite par IP est une règle
  // WAF du tableau de bord, pas un binding.
  "ratelimits": [
    {
      "name": "DEVICE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],

  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "PUBLIC_ORIGIN": "https://api-preview.{{DOMAIN}}",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "calmcut-db-preview",
          "database_id": "PLACEHOLDER_A_REMPLACER",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "DATA", "bucket_name": "calmcut-data" }],
      "ratelimits": [
        { "name": "DEVICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
      ],
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_ORIGIN": "https://api.{{DOMAIN}}",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "calmcut-db",
          "database_id": "PLACEHOLDER_A_REMPLACER",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "DATA", "bucket_name": "calmcut-data" }],
      "ratelimits": [
        { "name": "DEVICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
      ],
    },
  },
}
